# ---- Core ----
NODE_ENV=development
LOG_LEVEL=info

# ---- API ----
API_PORT=4000
# Public base URL of the API, used to build tracking + unsubscribe links.
PUBLIC_API_URL=http://localhost:4000
# Comma-separated allowed CORS origins (the web app).
WEB_ORIGIN=http://localhost:5173

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
# HMAC secret for signing tracked links / unsubscribe tokens.
LINK_SIGNING_SECRET=dev-link-secret-change-me

# ---- Database (MySQL — the only infrastructure this app needs) ----
# Use your local MySQL 8 server. Create the database first:
#   mysql -u root -p -e "CREATE DATABASE dispatch CHARACTER SET utf8mb4;"
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dispatch
DB_USER=root
DB_PASSWORD=

# ---- Queue ----
# The job queue is a table in the database above; there is no Redis.
# How fast the worker polls each queue is fixed in code; these tune sending:

# ---- Sending ----
# mock = write to ./.mail-outbox and log
# smtp = send via an SMTP server (see SMTP_* below)
# ses  = real AWS SES (keep off until the domain is verified)
EMAIL_PROVIDER=mock
EMAIL_FROM="Dispatch <no-reply@example.com>"
# Physical postal address shown in the email footer (CAN-SPAM).
EMAIL_SENDER_ADDRESS=123 Example St, Example City, EX 00000
# SES sandbox limits — raised via config once the account leaves sandbox.
SEND_RATE_PER_SEC=1
SEND_DAILY_CAP=200
SEND_MAX_ATTEMPTS=5
SEND_BACKOFF_MS=30000
# Recurring campaign cron expressions evaluate in this timezone.
SCHEDULER_TIMEZONE=UTC

# Dev-only: make the mock provider fail a fraction of sends to exercise retry/DLQ.
MOCK_FAIL_RATE=0

# ---- SMTP (only needed when EMAIL_PROVIDER=smtp) ----
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587/25 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---- AWS SES (only needed when EMAIL_PROVIDER=ses) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=

# ---- Observability ----
SENTRY_DSN=

# ---- Bootstrap admin (created by npm run db:seed) ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme12345
