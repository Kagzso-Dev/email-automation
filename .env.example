# ---- Core ----
NODE_ENV=development
LOG_LEVEL=info

# ---- API ----
API_PORT=4000
# Public base URL of the API, used to build tracking + unsubscribe links.
PUBLIC_API_URL=http://localhost:4000
# Comma-separated allowed CORS origins (the web app).
WEB_ORIGIN=http://localhost:5173

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
# HMAC secret for signing tracked links / unsubscribe tokens.
LINK_SIGNING_SECRET=dev-link-secret-change-me

# ---- Database ----
# Host-run dev uses localhost; docker-compose overrides host to "postgres".
DATABASE_URL=postgresql://dispatch:dispatch@localhost:5432/dispatch?schema=public

# ---- Redis / queue ----
REDIS_URL=redis://localhost:6379

# ---- Sending ----
# mock = write to ./.mail-outbox and log; ses = real AWS SES (keep off until domain verified).
EMAIL_PROVIDER=mock
EMAIL_FROM="Dispatch <no-reply@example.com>"
# Physical postal address shown in the email footer (CAN-SPAM).
EMAIL_SENDER_ADDRESS=123 Example St, Example City, EX 00000
# SES sandbox limits — raised via config once the account leaves sandbox.
SEND_RATE_PER_SEC=1
SEND_DAILY_CAP=200
SEND_WORKER_CONCURRENCY=2
SEND_MAX_ATTEMPTS=5
SEND_BACKOFF_MS=30000
# Recurring campaign cron expressions evaluate in this timezone.
SCHEDULER_TIMEZONE=UTC

# Dev-only: make the mock provider fail a fraction of sends to exercise retry/DLQ.
MOCK_FAIL_RATE=0

# ---- AWS SES (only needed when EMAIL_PROVIDER=ses) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=

# ---- Observability ----
SENTRY_DSN=
BULL_BOARD_ENABLED=true

# ---- Bootstrap admin (created by npm run db:seed) ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme12345
