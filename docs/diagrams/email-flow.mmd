---
config:
  layout: elk
  theme: default
  flowchart:
    htmlLabels: true
---
%% EML — Email flow: import -> approved-domain check -> skip/accept -> template -> send -> tracking -> status -> hard stop.
%% Key files: apps/api/src/queue/contactImport.ts, domain/sendingDomainPolicy.ts, domain/manualSend.ts,
%% queue/manualBulkSend.ts, domain/delivery.ts, domain/tracking.ts, domain/hardStop.ts
flowchart TD
  subgraph UI["User / UI"]
    direction TB
    E1["Email Contacts: upload .csv / .xlsx / .pdf"]
    E2["Settings: Approved sending domains (ADMIN); Blocked list + Domain mode if ENABLE_DOMAIN_BLOCKLIST"]
    E3["Email Templates: create / edit (ADMIN)"]
    E4["Select contacts + template -> Send (drip batch) or Send one"]
    E5["Campaigns: Schedule / Send now (ADMIN)"]
    E6["Hard stop: one batch, Email section, or Stop all (ADMIN)"]
    R1["Recipient opens, clicks or unsubscribes"]
  end

  subgraph BE["Orchestrator Backend"]
    direction TB
    B1["POST /api/contacts/import -> enqueue csv-import job (first 1,000 rows)"]
    B2["Worker processContactImport: loadDomainPolicy (read fresh)"]
    D1{"Row has a usable email?"}
    D2{"Domain passes policy? ALLOWLIST: on Approved list, or list empty. BLOCKLIST: not blocked (incl. subdomains)"}
    B3["Upsert Contact on email (+ list membership)"]
    B4["POST /api/contacts/send -> createManualSendBatch"]
    D3{"Contact suppressed (unsubscribed / bounced / complained) or domain refused?"}
    B5["Item PENDING; enqueue manual-bulk-send"]
    B6["Worker processManualBulkSend: next PENDING item"]
    D4{"Daily cap SEND_DAILY_CAP reached (UTC day)?"}
    D5{"Batch still RUNNING and item claimable?"}
    B7["deliverEmail: idempotency check, EmailLog QUEUED"]
    D6{"Suppressed at send time?"}
    D7{"Domain still allowed at send time?"}
    B8["Render template, inline images, open pixel + signed click links (EMAIL_TRACKING)"]
    D8{"SMTP accepted the message?"}
    B9["EmailLog SENT + item SENT"]
    B10["Random gap min..max sec -> next item; batch DONE; optional lead-gen purge of SENT contacts"]
    B11["Scheduler tick 15 s -> campaign-dispatch -> fan-out one send-email job per list member"]
    B12["send-email worker: hard-stop check, daily cap, deliverEmail; retry with backoff up to SEND_MAX_ATTEMPTS"]
    B13["GET /api/track/open -> OPENED; GET /api/track/click (HMAC) -> CLICKED + 302"]
    B14["POST /api/unsubscribe/:token -> Contact UNSUBSCRIBED + Unsubscribe row"]
    B15["pressHardStop: PENDING items CANCELLED, campaigns PAUSED, triggers off, queued email jobs cancelled; in-progress sends finish"]
    B16["Hard-stop finalizer 15 s: STOPPING -> STOPPED"]
    F1["Skipped: no email"]
    F2["rejectedDomain: not imported"]
    F3["Item SKIPPED with reason"]
    F4["Defer job to next UTC midnight"]
    F5["Stop: batch cancelled / hard-stopped"]
    F6["EmailLog FAILED: suppressed / domain not approved; item SKIPPED"]
    F7["EmailLog FAILED (5xx permanent or 4xx transient); item FAILED; batch continues"]
    G1["GAP: no production bounce / complaint / reply intake - applyDeliveryEvent is only called by the dev simulate route"]
  end

  subgraph DB["Database (MySQL)"]
    direction TB
    T1[("Contact, ListMembership")]
    T2[("AllowedDomain, BlockedSendingDomain, Setting sendingDomainMode")]
    T3[("Template")]
    T4[("ManualSendBatch, ManualSendBatchItem")]
    T5[("EmailLog ledger")]
    T6[("Job queue table")]
    T7[("Unsubscribe")]
    T8[("HardStop, HardStopItem")]
  end

  subgraph EXT["External Services"]
    direction TB
    X1["SMTP server (Settings -> Email SMTP first, .env fallback) or mock outbox"]
    X2["Recipient mailbox"]
  end

  E1 --> B1 --> T6
  T6 --> B2 --> D1
  D1 -->|"no"| F1
  D1 -->|"yes"| D2
  D2 -->|"no"| F2
  D2 -->|"yes"| B3 --> T1
  E2 --> T2
  T2 -.->|"policy"| D2
  E3 --> T3
  E4 --> B4 --> D3
  D3 -->|"yes"| F3 --> T4
  D3 -->|"no"| B5 --> T4
  B5 --> T6
  T6 --> B6 --> D4
  D4 -->|"yes"| F4
  D4 -->|"no"| D5
  D5 -->|"no"| F5
  D5 -->|"yes"| B7 --> T5
  B7 --> D6
  D6 -->|"yes"| F6
  D6 -->|"no"| D7
  D7 -->|"no"| F6
  D7 -->|"yes"| B8 --> X1 --> D8
  D8 -->|"no"| F7 --> T5
  D8 -->|"yes"| B9 --> T5
  B9 --> B10
  F7 --> B10
  X1 --> X2
  E5 --> B11 --> T6
  T6 --> B12 --> B7
  X2 --> R1
  R1 --> B13 --> T5
  R1 --> B14 --> T7
  T7 -.->|"isSuppressed blocks future sends"| D6
  X2 -.->|"bounce / complaint / reply"| G1
  E6 --> B15 --> T8
  B15 --> T4
  B16 --> T8

  classDef fail fill:#fdecea,stroke:#c0392b,color:#7b1d14
  classDef gap fill:#fff4ce,stroke:#b7791f,color:#5f370e
  class F1,F2,F3,F4,F5,F6,F7 fail
  class G1 gap
