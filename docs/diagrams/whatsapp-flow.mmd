config:
  layout: elk
  theme: default
  flowchart:
    htmlLabels: true
---
%% WA — WhatsApp flow: credentials -> contact import -> template approval -> send -> delivery webhook -> inbox -> status.
%% Key files: apps/api/src/http/routes/whatsapp.ts, routes/whatsappTemplateSync.ts, domain/whatsappSend.ts,
%% queue/whatsappBulkSend.ts, routes/whatsappWebhook.ts, domain/whatsappWebhook.ts, domain/whatsappTracking.ts, domain/whatsappInbox.ts
flowchart TD
  subgraph UI["User / UI"]
    direction TB
    W1["Settings: Meta token, phone number id, WABA id, app secret, verify token (ADMIN) - or .env"]
    W2["WhatsApp Contacts: upload .csv / .xlsx"]
    W3["WhatsApp Templates: Create in Meta / Sync from Meta / header media (ADMIN)"]
    W4["Select recipients + template -> Send"]
    W5["WhatsApp Inbox: read thread, reply (ADMIN)"]
    W6["Hard stop: one batch, WhatsApp section, or Stop all"]
  end

  subgraph BE["Orchestrator Backend"]
    direction TB
    A1["POST /api/whatsapp/contacts/import: parse, normalise phone (WHATSAPP_DEFAULT_COUNTRY_CODE)"]
    D1{"Usable phone number?"}
    A2["Upsert WhatsAppContact on phone"]
    A3["POST /templates/meta-create -> submitted for Meta review"]
    A4["GET / POST /templates/meta-sync -> register Meta templates"]
    A5["GET /templates/verify: compare with Meta list (cached 5 min)"]
    D2{"Meta template status APPROVED?"}
    S1["Badge: verified"]
    S2["Badge: pending / failed / not_found - display only, does NOT block sending"]
    A6["POST /api/whatsapp/send"]
    D3{"Not archived, Meta template name set, header media set if needed, WhatsApp configured?"}
    A7["createWhatsAppSendBatch: check each recipient"]
    D4{"Valid phone, not a duplicate, contact ACTIVE, every template variable has a value?"}
    A8["Send row QUEUED; enqueue whatsapp-bulk-send"]
    A9["Worker processWhatsAppBulkSend: next QUEUED"]
    D5{"Meta 131049 marketing cooldown active for this number?"}
    D6{"Batch RUNNING and row claimable (QUEUED -> SENDING)?"}
    A10["sendTemplateMessage"]
    A11["SENT + wamid; random gap WHATSAPP_MIN..MAX_DELAY_SEC; next; batch DONE"]
    A12["POST /api/webhooks/whatsapp (raw body)"]
    D8{"App secret set and X-Hub-Signature-256 valid?"}
    A13["statuses: forward-only SENT -> DELIVERED -> READ, or FAILED + Meta code; pricing saved; lead-gen purge on delivery"]
    A14["messages: upsert inbound on wamid, link contact; media -> whatsapp-media-download job"]
    A15["Worker processWhatsAppMediaDownload -> WHATSAPP_MEDIA_DIR"]
    D9{"Customer messaged within the last 24 h?"}
    A16["Send free-form text / media reply"]
    A17["pressHardStop: QUEUED rows CANCELLED; SENDING rows finish"]
    F1["Row skipped: no valid phone"]
    F2["400 / 503: nothing queued"]
    F3["Send row SKIPPED with reason"]
    F4["SKIPPED: 131049 cooldown"]
    F5["Stop: batch cancelled / hard-stopped"]
    F6["Send row FAILED with Meta error code - not retried"]
    F7["401 rejected"]
    F8["409: window closed - send an approved template instead"]
    G1["GAP: replies like STOP / Not interested are badges only - contact status never changes automatically"]
  end

  subgraph DB["Database (MySQL)"]
    direction TB
    T1[("Setting: whatsappMetaCredentials (plaintext JSON)")]
    T2[("whatsapp_contacts")]
    T3[("whatsapp_templates, whatsapp_template_header_media")]
    T4[("whatsapp_send_batches, whatsapp_sends")]
    T5[("whatsapp_inbound_messages, whatsapp_media, whatsapp_conversation_reads")]
    T6[("Job queue table")]
    T7[("whatsapp_message_pricing")]
  end

  subgraph EXT["External Services - Meta WhatsApp Cloud API"]
    direction TB
    M1["POST /{waba-id}/message_templates - Meta review"]
    M2["GET /{waba-id}/message_templates"]
    M3["POST /{phone-number-id}/messages"]
    D7{"Meta accepts the message? (template approved, number on WhatsApp, policy OK)"}
    M4["Meta webhook delivery: statuses + inbound messages"]
    M5["GET /{media-id} + download"]
  end

  W1 --> T1
  W2 --> A1 --> D1
  D1 -->|"no"| F1
  D1 -->|"yes"| A2 --> T2
  W3 --> A3 --> M1
  A3 --> T3
  W3 --> A4 --> M2
  A4 --> T3
  W3 --> A5 --> M2
  A5 --> D2
  D2 -->|"yes"| S1
  D2 -->|"no"| S2
  W4 --> A6 --> D3
  D3 -->|"no"| F2
  D3 -->|"yes"| A7 --> D4
  D4 -->|"no"| F3 --> T4
  D4 -->|"yes"| A8 --> T4
  A8 --> T6
  T6 --> A9 --> D5
  D5 -->|"yes"| F4
  D5 -->|"no"| D6
  D6 -->|"no"| F5
  D6 -->|"yes"| A10 --> M3 --> D7
  D7 -->|"no"| F6 --> T4
  D7 -->|"yes"| A11 --> T4
  M4 --> A12 --> D8
  D8 -->|"no"| F7
  D8 -->|"yes"| A13 --> T4
  A13 --> T7
  D8 -->|"yes"| A14 --> T5
  A14 --> T6
  T6 --> A15 --> M5
  A14 -.-> G1
  W5 --> D9
  D9 -->|"no"| F8
  D9 -->|"yes"| A16 --> M3
  W6 --> A17 --> T4

  classDef fail fill:#fdecea,stroke:#c0392b,color:#7b1d14
  classDef gap fill:#fff4ce,stroke:#b7791f,color:#5f370e
  class F1,F2,F3,F4,F5,F6,F7,F8 fail
  class G1,S2 gap
