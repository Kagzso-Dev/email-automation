b" aria-selected="false" class="rounded-t-lg px-4 py-2.5 text-sm font-medium transition-colors duration-200 text-slate-550 hover:bg-tint hover:text-ink">Duplicate (1)</button><button type="button" role="tab" aria-selected="false" class="rounded-t-lg px-4 py-2.5 text-sm font-medium transition-colors duration-200 text-slate-550 hover:bg-tint hover:text-ink">Excluded (1)</button><span aria-hidden="true" class="pointer-events-none absolute -bottom-px left-0 h-[3px] w-px origin-left rounded-full bg-gradient-accent transition-transform duration-300 ease-in-out-soft motion-reduce:transition-none" style="transform: translateX(0px) scaleX(0);"></span></div><div class="-mx-4 overflow-x-auto rounded-xl border-y border-line/70 bg-surface shadow-card sm:mx-0 sm:rounded-xl sm:border-x"><table class="table-soft w-full min-w-[44rem] text-sm"><thead><tr class="border-b border-line text-left"><th class="px-4 py-3 text-xs font-semibold uppercase tracking-[0.06em] text-slate-550"><input type="checkbox" aria-label="Select all valid rows shown"></th><th class="px-4 py-3 text-xs font-semibold uppercase tracking-[0.06em] text-slate-550">Row</th><th class="px-4 py-3 text-xs font-semibold uppercase tracking-[0.06em] text-slate-550">Name</th><th class="px-4 py-3 text-xs font-semibold uppercase tracking-[0.06em] text-slate-550">Phone</th><th class="px-4 py-3 text-xs font-semibold uppercase tracking-[0.06em] text-slate-550">Business</th><th class="px-4 py-3 text-xs font-semibold uppercase tracking-[0.06em] text-slate-550">Check</th><th class="px-4 py-3 text-xs font-semibold uppercase tracking-[0.06em] text-slate-550">Score</th><th class="px-4 py-3 text-xs font-semibold uppercase tracking-[0.06em] text-slate-550">Notes</th><th class="px-4 py-3 text-xs font-semibold uppercase tracking-[0.06em] text-slate-550">Review</th></tr></thead><tbody><tr class="border-b border-line-subtle align-top last:border-0"><td class="px-4 py-3"><input type="checkbox" aria-label="Select row 2"></td><td class="px-4 py-